{
  "uid": "jp-seismic-pipeline",
  "title": "JP Seismic Pipeline",
  "description": "Freshness, run outcomes and warehouse volume for the jp-seismic-pipeline ELT.",
  "tags": ["seismic", "elt", "pipeline"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "1m",
  "time": { "from": "now-30d", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Time since last successful ingest",
      "description": "Advanced only by a run that completed. A failed run leaves this climbing.",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - max(jp_seismic_ingest_last_success_timestamp_seconds)",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 93600 },
              { "color": "red", "value": 129600 }
            ]
          },
          "noValue": "never ran"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Warehouse freshness",
      "description": "Age of the newest row in raw.earthquake_events, straight from the database.",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "postgres", "uid": "seismic-postgres" },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "select extract(epoch from now() - max(ingested_at))::float8 as age_seconds from raw.earthquake_events"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 93600 },
              { "color": "red", "value": 129600 }
            ]
          },
          "noValue": "no rows"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Rows written (last run)",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum(jp_seismic_ingest_rows_written)", "instant": true }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "noValue": "0" },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Rows rejected (last run)",
      "description": "Anything above zero means the source emitted records the loader could not key.",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum(jp_seismic_ingest_rows_rejected)", "instant": true }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Raw events landed",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 4 },
      "datasource": { "type": "postgres", "uid": "seismic-postgres" },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "select count(*) as raw_events from raw.earthquake_events"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Fact rows modelled",
      "description": "analytics_marts.fct_earthquakes — should track the raw count once dbt has run.",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 4 },
      "datasource": { "type": "postgres", "uid": "seismic-postgres" },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "select count(*) as fact_rows from analytics_marts.fct_earthquakes"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "noValue": "not built" }, "overrides": [] },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      }
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Newest event modelled",
      "description": "Event time, not ingest time: the lag between the two is the pipeline's real latency.",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 4 },
      "datasource": { "type": "postgres", "uid": "seismic-postgres" },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "select extract(epoch from now() - max(occurred_at))::float8 as event_lag_seconds from analytics_marts.fct_earthquakes"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "noValue": "not built" }, "overrides": [] },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      }
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Ingest duration (last run)",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "max(jp_seismic_ingest_duration_seconds)",
          "instant": true
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "noValue": "never ran" }, "overrides": [] },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Events per JST day",
      "description": "Straight from analytics_marts.agg_daily_seismic_activity — the business output of the pipeline.",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "postgres", "uid": "seismic-postgres" },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "select activity_date::timestamptz as time, sum(event_count) as events, sum(damaging_event_count) as damaging from analytics_marts.agg_daily_seismic_activity group by 1 order by 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "bars", "fillOpacity": 60, "lineWidth": 1 }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "none" }
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Ingest volume per run",
      "description": "Read vs written vs rejected. Read climbing while written stays flat means the source is re-sending unchanged events, which is normal; written collapsing to zero is not.",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum(jp_seismic_ingest_rows_read)", "legendFormat": "read" },
        { "refId": "B", "expr": "sum(jp_seismic_ingest_rows_written)", "legendFormat": "written" },
        { "refId": "C", "expr": "sum(jp_seismic_ingest_rows_rejected)", "legendFormat": "rejected" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "showPoints": "auto" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "none" }
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Airflow task outcomes (hourly)",
      "description": "From the scheduler's StatsD stream. A flat zero on failures with no successes means the DAG is not running at all.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 17 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "increase(airflow_ti_successes[1h])",
          "legendFormat": "successes"
        },
        {
          "refId": "B",
          "expr": "increase(airflow_ti_failures[1h])",
          "legendFormat": "failures"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "bars", "fillOpacity": 70, "lineWidth": 1 }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "failures" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }]
          }
        ]
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "none" }
      }
    },
    {
      "id": 12,
      "type": "table",
      "title": "Most active regions (last 30 JST days)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 17 },
      "datasource": { "type": "postgres", "uid": "seismic-postgres" },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "select region_name, sum(event_count) as events, max(max_magnitude) as max_magnitude from analytics_marts.agg_daily_seismic_activity where activity_date >= current_date - 30 group by 1 order by 2 desc limit 15"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "showHeader": true }
    },
    {
      "id": 13,
      "type": "logs",
      "title": "Run summaries and failures",
      "description": "Container stdout plus Airflow's per-task log files. Filtered to the lines that decide whether a run was healthy — open Explore on the Loki datasource for the unfiltered stream.",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 25 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "expr": "{job=~\"docker|airflow-tasks\"} |~ \"(?i)(error|traceback|failed|ingest complete|pushed run metrics)\"",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      }
    }
  ]
}
