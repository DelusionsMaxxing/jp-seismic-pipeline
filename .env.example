# Copy to .env and adjust. Docker Compose picks this up automatically.
# The defaults below match the compose stack, so it runs unchanged.

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=seismic
POSTGRES_PASSWORD=seismic
POSTGRES_DB=seismic

DBT_PROJECT_DIR=./dbt
DBT_PROFILES_DIR=./dbt

# Monitoring. Leave PUSHGATEWAY_URL empty to run without the metrics stack —
# the pipeline then skips publishing instead of failing.
PUSHGATEWAY_URL=http://localhost:9091
METRICS_JOB_NAME=jp_seismic_ingest

# Local-development passwords for the monitoring roles. Override these
# anywhere that is not a laptop; they are read by the Postgres init scripts
# on first start, so changing them later needs `make clean`.
READONLY_PASSWORD=readonly
EXPORTER_PASSWORD=exporter
GRAFANA_ADMIN_PASSWORD=admin
